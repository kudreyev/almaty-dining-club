# Публичный origin сайта (ссылки активации, QR, OAuth redirect).
NEXT_PUBLIC_SITE_URL=https://kudaclub.kz

# Публичный ID счётчика Яндекс.Метрики (доступен в браузере).
NEXT_PUBLIC_YM_ID=

# Meta Pixel ID (публичный). Если пусто — скрипт Pixel не загружается.
NEXT_PUBLIC_META_PIXEL_ID=1305203121580677

# Meta Conversions API (только сервер, без NEXT_PUBLIC_).
META_PIXEL_ID=1305203121580677
META_CAPI_ACCESS_TOKEN=

# Yandex.Metrica OAuth token для server-side Reporting/Management API.
# Получить: https://oauth.yandex.ru/client/my → debug-token или зарегистрировать
# OAuth-приложение. Используется только в /api/cron/metrica-sync.
YANDEX_OAUTH_TOKEN=

# Секрет для защиты cron-роутов. Vercel автоматически подставляет его
# в header Authorization при вызове по расписанию. Сгенерировать:
# `openssl rand -hex 32`
CRON_SECRET=

# Telegram-бот для ежедневных алертов (/api/cron/daily-snapshot, Слой 3).
# Создать бота: @BotFather → /newbot. chat_id: написать боту, затем
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# OpenAI для weekly digest (/api/cron/weekly-digest, Слой 4).
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# WhatsApp Business Cloud API (Слой 5 — webhook + исходящие ответы).
# Meta Developer → App → WhatsApp → API Setup.
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# false = фаза 1: только черновики, ответ с телефона. true = отправка из /admin/whatsapp.
WHATSAPP_OUTBOUND_ENABLED=false
