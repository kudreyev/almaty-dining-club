# Публичный origin сайта (ссылки активации, QR, OAuth redirect).
NEXT_PUBLIC_SITE_URL=https://kudaclub.kz

# Публичный ID счётчика Яндекс.Метрики (доступен в браузере).
NEXT_PUBLIC_YM_ID=

# Meta Pixel ID (публичный). Если пусто — скрипт Pixel не загружается.
NEXT_PUBLIC_META_PIXEL_ID=1305203121580677

# Meta Conversions API (только сервер, без NEXT_PUBLIC_).
META_PIXEL_ID=1305203121580677
META_CAPI_ACCESS_TOKEN=

# Yandex.Metrica OAuth token для server-side Reporting/Management API.
# Получить: https://oauth.yandex.ru/client/my → debug-token или зарегистрировать
# OAuth-приложение. Используется только в /api/cron/metrica-sync.
YANDEX_OAUTH_TOKEN=

# Секрет для защиты cron-роутов. Vercel автоматически подставляет его
# в header Authorization при вызове по расписанию. Сгенерировать:
# `openssl rand -hex 32`
CRON_SECRET=

# Telegram-бот для ежедневных алертов (/api/cron/daily-snapshot, Слой 3).
# Создать бота: @BotFather → /newbot. chat_id: написать боту, затем
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# OpenAI для weekly digest (/api/cron/weekly-digest, Слой 4).
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# TipTop Pay — из личного кабинета merchant.tiptoppay.kz.
# NEXT_PUBLIC_TIPTOPPAY_PUBLIC_ID — Public ID терминала (доступен в браузере, виджет).
# TIPTOPPAY_PUBLIC_ID / TIPTOPPAY_API_SECRET — только сервер (Basic Auth к API + HMAC).
NEXT_PUBLIC_TIPTOPPAY_PUBLIC_ID=
TIPTOPPAY_PUBLIC_ID=
TIPTOPPAY_API_SECRET=

# Цена подписки (тенге). Клиент читает NEXT_PUBLIC_PRICE.
PRICE=1990
NEXT_PUBLIC_PRICE=1990

# Ссылка «ваш доступ» в WhatsApp/SMS после оплаты (главная с каталогом).
ACCESS_URL=https://kudaclub.kz
# CABINET_URL=   # устаревший алиас ACCESS_URL, можно не задавать

# Twilio (WhatsApp OTP + Utility access + SMS fallback).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# TWILIO_CONTENT_SID_VERIFICATION=
# TWILIO_CONTENT_SID_ACCESS=   # Utility-шаблон «доступ после оплаты» (после одобрения Meta)
# WHATSAPP_LOGIN_CODE_SECRET=
# SMS-fallback после оплаты временно отключён (нет Twilio SMS).

# --- /admin/analytics (рекламные метрики + ledger) ---
# Facebook Marketing API (cron /api/cron/ad-stats, 07:00 Алматы).
FB_TOKEN=
FB_AD_ACCOUNT=

# Яндекс.Метрика для daily_ad_stats.
# Достаточно YANDEX_METRIKA_OAUTH_TOKEN + YANDEX_METRIKA_COUNTER_ID (или NEXT_PUBLIC_YM_ID).
# Альтернативы: METRIKA_TOKEN / YANDEX_OAUTH_TOKEN, METRIKA_COUNTER_ID.
METRIKA_TOKEN=
METRIKA_COUNTER_ID=
YANDEX_METRIKA_OAUTH_TOKEN=
YANDEX_METRIKA_COUNTER_ID=
# Числовой ID цели в кабинете Метрики (не имя JS-события).
METRIKA_GOAL_CLICK_PAY=

# Вебхуки TipTop (задать в ЛК уведомлений):
#   Pay:       https://kudaclub.kz/api/webhooks/ttp/pay
#   Fail:      https://kudaclub.kz/api/webhooks/ttp/fail
#   Recurrent: https://kudaclub.kz/api/webhooks/ttp/recurrent
# (старые /api/tiptoppay/* продолжают работать и тоже пишут ledger)

