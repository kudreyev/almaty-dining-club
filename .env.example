# Monorepo env entrypoint.
# Copy this file into:
# - apps/frontend/.env.local
# - apps/backend/.env
# and then adjust the values below for each app.

NODE_ENV=development

# Frontend
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=
NEXT_PUBLIC_TZ=Asia/Almaty
INTERNAL_API_URL=http://backend:4000
FRONTEND_PORT=3001

# Backend
PORT=4000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3001
DATABASE_URL=postgres://adc:adc@postgres:5432/adc
SESSION_SECRET=replace-with-a-strong-random-secret
SESSION_COOKIE_NAME=adc_session
SESSION_TTL_SECONDS=2592000
AUTH_DEBUG=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=whatsapp:+77000000000
TWILIO_CONTENT_SID_VERIFICATION=
WHATSAPP_LOGIN_CODE_SECRET=replace-with-a-long-random-secret
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=miniopassword
S3_BUCKET=restaurant-photos
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://localhost:9000
