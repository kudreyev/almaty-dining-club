{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/metrica-sync",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/cron/daily-snapshot",
      "schedule": "30 22 * * *"
    },
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 23 * * 0"
    },
    {
      "path": "/api/cron/ad-stats",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/analytics-digest",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/push-digest",
      "schedule": "0 7 * * 4"
    },
    {
      "path": "/api/cron/push-inactivity",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/push-new-offer",
      "schedule": "0 7 * * *"
    }
  ]
}
